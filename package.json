{
  "name": "node-api",
  "version": "1.0.0",
  "description": "Node.js Web API that fetches data from 3rd party API and stores in SQLite",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "init-db": "node src/database/init.js",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js",
    "test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js --coverage",
    "test:unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js tests/services tests/controllers",
    "test:integration": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js tests/integration",
    "test:ci": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --config jest.config.js --coverage --watchAll=false --verbose"
  },
  "keywords": ["nodejs", "express", "api", "sqlite"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8",
    "jest-environment-node": "^29.7.0",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}